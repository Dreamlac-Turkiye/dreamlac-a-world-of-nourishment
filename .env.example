# Dreamlac environment example — never add real keys to Git

# Public configuration
VITE_SITE_URL=http://localhost:8080
VITE_DEFAULT_MARKET=TR
APP_ENV=development

# Supabase public configuration (browser-safe but environment-specific)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only — configure in the deployment secret manager, never with a VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY=

# Providers stay disabled until adapter and credentials pass staging certification
TR_PAYMENT_PROVIDER=disabled
TR_SHIPPING_PROVIDER=disabled
TR_INVOICE_PROVIDER=disabled
TR_EMAIL_PROVIDER=disabled
TR_SMS_PROVIDER=disabled

# Add provider-specific secrets only after selection. Card data is never stored here.
